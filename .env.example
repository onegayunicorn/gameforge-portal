# GameForge Portal host environment.
#
# On the VM:  cp .env.example .env
# systemd reads this file through `EnvironmentFile=-/srv/gameforge/gameforge-portal/.env`
# (see infra/systemd/gameforge.service). Nothing in the code base loads .env by itself —
# there is no dotenv dependency — so a variable added here only reaches the process if
# systemd passes it through, which it does for every key in this file.
#
# Never commit .env: it is ignored by .gitignore.

# Bind address. Keep it on loopback so the Node process is only reachable through nginx.
HOST=127.0.0.1

# Port the Node runtime listens on. infra/nginx/gameforge-locations.conf proxies /api/
# to this port; change one, change the other.
PORT=4173

NODE_ENV=production

# Not read by the current server; kept as the documented place for future settings such
# as a catalogue database URL or signing key for launch tickets.
# DATABASE_URL=file:/srv/gameforge/gameforge-portal/data/db.sqlite
