# The deploy host is Linux; a CRLF shebang fails with ": bad interpreter: /usr/bin/env: no such file".
# These paths must stay LF no matter which machine checks the repository out.
*.sh            text eol=lf
infra/**        text eol=lf
scripts/*.sh    text eol=lf
*.service       text eol=lf
*.conf          text eol=lf

# Installers handed to Windows users keep their platform handling.
*.ps1           text eol=crlf
*.ico           binary
*.png           binary
*.exe           binary
*.zip           binary
