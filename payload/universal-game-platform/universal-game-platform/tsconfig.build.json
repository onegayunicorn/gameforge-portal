{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": false,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "packages/asset-schema/src/index.ts",
    "packages/audio-contracts/src/index.ts",
    "packages/build-graph/src/index.ts",
    "packages/capability-registry/src/index.ts",
    "packages/compiler-registry/src/index.ts",
    "packages/devkit-registry/src/index.ts",
    "packages/diagnostics/src/index.ts",
    "packages/input-contracts/src/index.ts",
    "packages/license-registry/src/index.ts",
    "packages/network-contracts/src/index.ts",
    "packages/physics-contracts/src/index.ts",
    "packages/provenance/src/index.ts",
    "packages/renderer-contracts/src/index.ts",
    "packages/runtime-contracts/src/index.ts",
    "packages/save-contracts/src/index.ts",
    "packages/shader-pipeline/src/index.ts",
    "packages/telemetry/src/index.ts",
    "packages/test-kit/src/index.ts",
    "packages/ui-kit/src/index.ts",
    "apps/asset-browser/src/index.ts",
    "apps/builder-cli/src/cli.ts",
    "apps/builder-cli/src/index.ts",
    "apps/preview/src/index.ts",
    "apps/studio/src/index.ts",
    "game/src/game.ts",
    "game/src/main.ts",
    "tests/platform/asset-contract.test.ts",
    "tests/platform/build-contract.test.ts",
    "tests/platform/capability-contract.test.ts",
    "tests/platform/deployment-contract.test.ts",
    "tests/platform/renderer-contract.test.ts",
    "tests/platform/runtime-contract.test.ts",
    "tests/platform/save-contract.test.ts",
    "tests/platform/vitest.config.ts",
    "types-shim.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "build"
  ]
}