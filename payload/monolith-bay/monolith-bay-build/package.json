{
  "name": "monolith-bay",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "validate:content": "pnpm --filter @monolith/content-validator validate",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual",
    "package": "pnpm build && pnpm validate:content && pnpm test",
    "preview": "pnpm --filter @monolith/game-web preview",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
