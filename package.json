{
  "name": "gameforge-portal",
  "productName": "GameForge Portal",
  "version": "1.0.0",
  "description": "GameForge Portal - desktop launcher and website portal for the game platform builds",
  "author": "GameForge",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "packageManager": "npm@10.9.2",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node scripts/serve.js",
    "scan": "node scripts/scan-builds.js",
    "pwa:build": "node scripts/build-pwa.js",
    "pwa:serve": "node scripts/serve-pwa.js",
    "pwa:audit": "electron scripts/pwa-audit.js selftest-pwa",
    "cli:bundle": "node scripts/bundle-cli.js",
    "engine:build": "tsc -p config/tsconfig.engine.json",
    "engine:check": "tsc -p config/tsconfig.check.json --noEmit",
    "engine:test": "vitest run --config config/vitest.config.ts",
    "game:create": "tsx tools/cli/gameforge.ts create",
    "game:dev": "tsx tools/cli/gameforge.ts dev",
    "game:build": "tsx tools/cli/gameforge.ts build",
    "games:build": "node scripts/generate-game-index.js",
    "games:validate": "tsx tools/cli/gameforge.ts validate",
    "games:smoke": "electron scripts/game-smoke.js games/examples/hello-render/dist selftest-game",
    "verify": "npm run engine:check && npm run engine:test && npm run games:validate && npm run games:build",
    "dist": "npm run cli:bundle && electron-builder --win nsis portable --x64",
    "api:test": "node --test services/api/test/*.test.mjs",
    "sdk:typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM packages/gameforge-contracts/src/index.ts packages/gameforge-app-sdk/src/index.ts",
    "sdk:test": "tsx --test packages/gameforge-contracts/test/*.test.ts",
    "schema:validate": "node tools/validate-app-manifest-schema.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.gameforge.portal",
    "productName": "GameForge Portal",
    "copyright": "Copyright (c) 2026 GameForge",
    "directories": {
      "output": "release-final",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "portal/**/*",
      "scripts/scan-builds.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      },
      {
        "from": "build-meta",
        "to": "build-meta"
      },
      {
        "from": "portal/data",
        "to": "portal/data"
      },
      {
        "from": "build/gameforge-cli.cjs",
        "to": "build/gameforge-cli.cjs"
      },
      {
        "from": "engine/src",
        "to": "engine/src"
      },
      {
        "from": "engine/package.json",
        "to": "engine/package.json"
      },
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "pipeline",
        "to": "pipeline"
      },
      {
        "from": "games",
        "to": "games"
      },
      {
        "from": "tools/schemas",
        "to": "tools/schemas"
      },
      {
        "from": "node_modules/esbuild",
        "to": "node_modules/esbuild"
      },
      {
        "from": "node_modules/@esbuild",
        "to": "node_modules/@esbuild"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GameForge-Portal-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameForge Portal",
      "artifactName": "GameForge-Portal-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "GameForge-Portal-Portable-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "asar": false,
    "afterPack": "scripts/after-pack.js"
  }
}
