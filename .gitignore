# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Packaged desktop output
# Installers are published as GitHub release assets instead of being committed:
# win-unpacked/GameForge Portal.exe alone is ~178 MB, over GitHub's 100 MB
# hard per-file limit, so a repository containing it cannot be pushed at all.
# ---------------------------------------------------------------------------
release/
release-final/

# ---------------------------------------------------------------------------
# Self-test captures that are regenerated on demand
# ---------------------------------------------------------------------------
selftest/
selftest-packaged/
selftest-portable/
selftest-site/
selftest-games/

# ---------------------------------------------------------------------------
# Engine build output
# ---------------------------------------------------------------------------
# Built games are regenerated by `npm run games:build`; the index that describes
# them (portal/data/games.json) is generated too, and is committed so the portal
# has something to render on a fresh clone.
games/*/dist/
games/*/*/dist/
engine/dist/
build/gameforge-cli.cjs
# NOTE: selftest-pwa/ is intentionally committed - build-pwa.js reads its captures
# for the manifest screenshots, so keeping them makes `npm run pwa:build` reproducible.

# ---------------------------------------------------------------------------
# Transient script output
# ---------------------------------------------------------------------------
*.log
*.out
*.err

# ---------------------------------------------------------------------------
# UE4 runtime redistributables
# ---------------------------------------------------------------------------
# Fetched from the PRIVATE repo onegayunicorn/gameforge-ue4-redist by
# `npm run ue4:fetch` and verified against config/ue4-redist.sha256.
# Never commit them here: this repository is public.
vendor/ue4-redist/

# ---------------------------------------------------------------------------
# Host-local configuration (never commit real secrets)
# ---------------------------------------------------------------------------
.env
infra/local/
