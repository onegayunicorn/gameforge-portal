{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameforge.example/schemas/app-manifest.schema.json",
  "title": "GameForge application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["appId", "name", "version", "publisher", "callbackUrls", "requestedCapabilities", "supportedClients", "supportedGameModes", "sdkVersion"],
  "properties": {
    "appId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9._-]{1,126}[a-zA-Z0-9])$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "publisher": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://[^\\s]+$" },
    "callbackUrls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://[^\\s]+$" } },
    "requestedCapabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["profile.read", "library.read", "library.write", "catalog.read", "project.read", "project.write", "build.create", "session.create", "session.read", "session.control", "stream.connect", "crossplay.identity", "crossplay.presence", "telemetry.write", "host.read", "host.manage"] } },
    "supportedClients": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["web", "pwa", "desktop", "android", "ios", "tv", "headset"] } },
    "supportedGameModes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["local", "browser", "remote", "vm"] } },
    "sdkVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "publicKey": { "type": "string", "minLength": 1 }
  }
}
